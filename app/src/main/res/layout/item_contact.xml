<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/navy"
    android:foreground="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="16dp"
    android:paddingVertical="12dp">

    <!-- Avatar -->
    <TextView
        android:id="@+id/tvAvatar"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/bg_input_dark"
        android:gravity="center"
        android:text="A"
        android:textColor="@color/green_accent"
        android:textSize="16sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- Contenedor horizontal para el nombre y el distintivo de clave -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvContactName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:textStyle="bold" />

            <!-- Indicador E2EE de Libsodium -->
            <ImageView
                android:id="@+id/ivKeyBadge"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginStart="6dp"
                android:contentDescription="Clave pública disponible"
                android:src="@android:drawable/ic_lock_lock"
                android:visibility="gone"
                app:tint="@color/green_accent" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvContactPhone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/mut_text"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Botón Editar -->
    <ImageView
        android:id="@+id/btnEditContact"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Editar contacto"
        android:padding="6dp"
        android:src="@android:drawable/ic_menu_edit"
        android:visibility="gone"
        app:tint="@color/mut_text" />

    <!-- Botón Eliminar -->
    <ImageView
        android:id="@+id/btnDeleteContact"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginStart="4dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Eliminar contacto"
        android:padding="6dp"
        android:src="@android:drawable/ic_menu_delete"
        android:visibility="gone"
        app:tint="@color/red_accent" />

</LinearLayout>