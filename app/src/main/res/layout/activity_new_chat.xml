<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/navy"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbarNewChat"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/navy"
        app:navigationIcon="@android:drawable/ic_menu_revert"
        app:navigationIconTint="@color/white"
        app:title="Nuevo Chat"
        app:titleTextColor="@color/white" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingBottom="12dp">

        <EditText
            android:id="@+id/etNcSearch"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_input_dark"
            android:hint="Buscar contacto..."
            android:paddingHorizontal="14dp"
            android:textColor="@color/white"
            android:textColorHint="@color/mut_text"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAddContact"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:text="+ Nuevo"
                android:textColor="@color/white"
                android:textSize="12sp"
                app:cornerRadius="8dp"
                app:strokeColor="@color/line_border" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnImportContacts"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginHorizontal="2dp"
                android:text="Importar"
                android:textColor="@color/white"
                android:textSize="12sp"
                app:cornerRadius="8dp"
                app:strokeColor="@color/line_border" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnNewGroup"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:text="Grupo"
                android:textColor="@color/white"
                android:textSize="12sp"
                app:cornerRadius="8dp"
                app:strokeColor="@color/line_border" />
        </LinearLayout>
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvNcList"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />
</LinearLayout>