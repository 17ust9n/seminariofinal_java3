<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/navy"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Título del Modal -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Editar Perfil"
        android:textColor="@color/white"
        android:textSize="18sp"
        android:textStyle="bold" />

    <!-- Campo Nombre -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Nombre de usuario"
        android:textColor="@color/mut_text"
        android:textSize="13sp" />

    <EditText
        android:id="@+id/etEditName"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_input_dark"
        android:hint="Ej: Agustín Mastriani"
        android:inputType="textPersonName"
        android:paddingHorizontal="14dp"
        android:textColor="@color/white"
        android:textColorHint="@color/mut_text"
        android:textSize="15sp" />

    <!-- Campo Email -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Correo electrónico"
        android:textColor="@color/mut_text"
        android:textSize="13sp" />

    <EditText
        android:id="@+id/etEditEmail"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_input_dark"
        android:hint="ejemplo@correo.com"
        android:inputType="textEmailAddress"
        android:paddingHorizontal="14dp"
        android:textColor="@color/white"
        android:textColorHint="@color/mut_text"
        android:textSize="15sp" />

    <!-- Botones de Acción -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancelEdit"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:text="Cancelar"
            android:textColor="@color/white"
            app:cornerRadius="8dp"
            app:strokeColor="@color/line_border" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSaveEdit"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:text="Guardar"
            android:textColor="@color/green_text"
            android:textStyle="bold"
            app:backgroundTint="@color/green_accent"
            app:cornerRadius="8dp" />
    </LinearLayout>

</LinearLayout>