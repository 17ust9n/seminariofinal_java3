<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/navy"
    tools:context=".OnboardingActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="22dp"
        android:gravity="center_horizontal">

        <!-- Logo Grande -->
        <ImageView
            android:id="@+id/imgBigLogo"
            android:layout_width="220dp"
            android:layout_height="120dp"
            android:layout_marginTop="24dp"
            android:adjustViewBounds="true"
            android:contentDescription="Starssenger Logo"
            android:src="@drawable/starssenger" />

        <!-- Eslogan Cifrado -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:text="Mensajería cifrada extremo a extremo. La clave sale de los números — no viaja. Solo viaja el mensaje cifrado."
            android:textColor="@color/mut_text"
            android:textSize="13sp" />

        <!-- Label Teléfono -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Tu número (con código de país)"
            android:textColor="@color/mut_text"
            android:textSize="13sp" />

        <!-- Input Teléfono -->
        <EditText
            android:id="@+id/etPhone"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_input_dark"
            android:hint="5491137824591"
            android:inputType="number"
            android:paddingHorizontal="14dp"
            android:textColor="@color/white"
            android:textColorHint="@color/mut_text"
            android:textSize="16sp" />

        <!-- Label Seguridad -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Seguridad"
            android:textColor="@color/mut_text"
            android:textSize="13sp" />

        <!-- Botones Nivel Seguridad (Normal / Blindado) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSecNormal"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:text="🔓 Normal"
                android:textColor="@color/white"
                app:strokeColor="@color/line_border"
                app:cornerRadius="10dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSecBlindado"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:text="🛡️ Blindado"
                android:textColor="@color/white"
                app:strokeColor="@color/line_border"
                app:cornerRadius="10dp" />
        </LinearLayout>

        <!-- Descripción Modo Blindado -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="🛡️ Blindado: los mensajes se borran solos a los 45s y no se guarda nada en el teléfono. Menos rastro para un spyware."
            android:textColor="@color/mut_text"
            android:textSize="12sp" />

        <!-- Botón Entrar -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEnter"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="28dp"
            android:text="Entrar"
            android:textColor="@color/green_text"
            android:textSize="15sp"
            android:textStyle="bold"
            app:backgroundTint="@color/green_accent"
            app:cornerRadius="10dp" />

        <!-- Mensaje de Error -->
        <TextView
            android:id="@+id/tvError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:textColor="@color/red_accent"
            android:textSize="14sp"
            android:visibility="gone"
            tools:text="Número no válido"
            tools:visibility="visible" />

    </LinearLayout>
</ScrollView>