<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/navy"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbarEditProfile"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/navy"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:navigationIconTint="@color/green_accent"
        app:title="Editar Perfil"
        app:titleTextColor="@color/white" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Número de Teléfono"
            android:textColor="@color/mut_text"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/etUserPhone"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_input_dark"
            android:hint="+54 9 11 1234-5678"
            android:inputType="phone"
            android:paddingHorizontal="16dp"
            android:textColor="@color/white"
            android:textColorHint="@color/mut_text" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSavePhone"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="24dp"
            android:text="Guardar Cambios"
            android:textColor="@color/white"
            app:cornerRadius="8dp" />

    </LinearLayout>
</LinearLayout>